# Copy to .env and fill in. .env is gitignored — never commit real values.

# Optional: used for AI role summaries (scraper/summarize.py) and
# python -m scraper.backfill_blurbs. Pipeline runs fully without any of these
# set — summaries/blurbs just stay blank.
# Anthropic is tried first. Set ONE of the following, not both —
# ANTHROPIC_API_KEY takes precedence:
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=   # e.g. a Claude Code OAuth token

# Falls back to Ollama Cloud (model gemma4:31b) if Anthropic is unset or its
# call fails. Free tier — get a key at ollama.com. May be several
# comma-separated keys (e.g. "key1,key2,key3,key4") — rotated automatically
# whenever one hits the free tier's hourly usage limit, so a scrape can keep
# going on the next key instead of stalling until the limit resets. See
# scraper/ollama_keys.py.
OLLAMA_API_KEY=
# OLLAMA_API_ENDPOINT=https://ollama.com   # default; override only for a self-hosted Ollama

# Optional: override where key-rotation state (which keys are currently
# exhausted) is persisted. Defaults to ../data/ollama_key_rotation.json when
# this repo is checked out nested inside the parent job_pipeline (shared
# with that pipeline's own Ollama calls), or a local file if run standalone.
# OLLAMA_KEY_ROTATION_STATE_FILE=

# Optional: pin AI summaries/blurbs to just one provider instead of the
# default Anthropic-then-Ollama fallback (same as --llm-provider). One of:
# anthropic, ollama. Leave unset (or "auto") for the default fallback.
# LLM_PROVIDER=

# Optional: required only for the usajobs board (scraper/boards/usajobs.py).
# Free, instant, self-service key — register at developer.usajobs.gov with
# an email address. Without these, every other board still scrapes fine;
# usajobs just logs a warning and contributes zero jobs that run.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=   # the email address you registered with
